import { useState } from 'react';

const PRODUCTS = [
  { id: 1, name: 'Mink Eyelashes', category: 'Eyelash', price: 2500, img: 'https://via.placeholder.com/200' },
  { id: 2, name: 'Brazilian Weave-On 24"', category: 'Hair', price: 45000, img: 'https://via.placeholder.com/200' },
  { id: 3, name: 'Pink Lips Cream', category: 'Lip Care', price: 1800, img: 'https://via.placeholder.com/200' },
  { id: 4, name: 'Glow Body Cream', category: 'Cream', price: 3500, img: 'https://via.placeholder.com/200' },
  { id: 5, name: 'Signature Perfume', category: 'Perfume', price: 12000, img: 'https://via.placeholder.com/200' },
];

export default function LoyaltyStore() {
  const [cart, setCart] = useState([]);
  const [ownerMode, setOwnerMode] = useState(false);

  const addToCart = (product) => {
    setCart(prev => {
      const existing = prev.find(p => p.id === product.id);
      if (existing) return prev.map(p => p.id === product.id ? {...p, qty: p.qty + 1} : p);
      return [...prev, {...product, qty: 1}];
    });
  };

  const total = cart.reduce((sum, item) => sum + item.price * item.qty, 0);

  return (
    <div className="min-h-screen bg-pink-50 text-gray-900">
      <header className="bg-white shadow-md p-4 flex justify-between items-center">
        <h1 className="text-2xl font-bold text-pink-600">Loyalty Store</h1>
        <button onClick={() => setOwnerMode(!ownerMode)} className="text-sm bg-pink-500 text-white px-3 py-1 rounded">
          {ownerMode ? 'Customer View' : 'Owner Mode'}
        </button>
      </header>

      <main className="p-6 grid md:grid-cols-3 gap-6">
        <section className="md:col-span-2">
          <h2 className="text-xl font-semibold mb-4">All Products</h2>
          <div className="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
            {PRODUCTS.map(p => (
              <div key={p.id} className="bg-white rounded-xl shadow p-4">
                <img src={p.img} alt={p.name} className="w-full h-40 object-cover rounded-lg mb-2"/>
                <h3 className="font-bold">{p.name}</h3>
                <p className="text-sm text-gray-500">{p.category}</p>
                <p className="text-pink-600 font-semibold mt-1">₦{p.price.toLocaleString()}</p>
                {!ownerMode && (
                  <button onClick={() => addToCart(p)} className="mt-2 w-full bg-pink-500 text-white py-2 rounded-lg hover:bg-pink-600">
                    Add to Cart
                  </button>
                )}
              </div>
            ))}
          </div>
        </section>

        <aside className="bg-white rounded-xl shadow p-4 h-fit sticky top-6">
          <h2 className="text-xl font-semibold mb-4">Cart</h2>
          {cart.length === 0 ? <p className="text-gray-500">Empty</p> : (
            <>
              {cart.map(item => (
                <div key={item.id} className="flex justify-between py-2 border-b">
                  <span>{item.name} x{item.qty}</span>
                  <span>₦{(item.price * item.qty).toLocaleString()}</span>
                </div>
              ))}
              <div className="mt-4 font-bold text-lg">Total: ₦{total.toLocaleString()}</div>
              <button className="mt-3 w-full bg-green-600 text-white py-2 rounded-lg">Checkout</button>
            </>
          )}
        </aside>
      </main>

      {ownerMode && (
        <footer className="fixed bottom-0 left-0 right-0 bg-yellow-100 p-3 text-center text-sm">
          Owner Mode Active — You can now edit products, view sales, manage inventory
        </footer>
      )}
    </div>
  );
}
